{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowImportingTsExtensions": false,
    "noEmit": false,
    "outDir": "dist",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2020",

    "baseUrl": ".",
    "paths": {
      "@app/*": ["Application/*"],
      "@domain/*": ["Domain/*"],
      "@infra/*": ["Infrastructure/*"],
      "@webapi/*": ["WebApi/*"],
      "@root/*": ["*"]
    },

    "lib": ["ES2020"]
  },
  "exclude": [
    "tests",
    "node_modules"
  ]
}