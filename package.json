{
  "name": "advanced-blog",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "tsx scripts/redis-start.ts && tsx -r tsconfig-paths/register WebApi/server.ts",
    "build": "prisma generate && prisma migrate deploy && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "start": "node -r tsconfig-paths/register dist/WebApi/server.js",
    "lint": "eslint .",
    "seed": "prisma db seed",
    "pretest": "docker stop redis-dev || echo Redis dev not running",
    "test": "docker compose -f docker-compose.test.yml up -d && cross-env DOTENV_CONFIG_PATH=.env.test TEST_IN_DOCKER=true tsx scripts/wait-for-db.ts && cross-env DOTENV_CONFIG_PATH=.env.test prisma migrate deploy && cross-env DOTENV_CONFIG_PATH=.env.test jest --runInBand && docker compose -f docker-compose.test.yml down -v",
    "test:ci": "jest --runInBand",
    "test:watch": "tsx scripts/redis-start.ts && cross-env DOTENV_CONFIG_PATH=.env.test jest --watchAll",
    "test:reset": "cross-env DOTENV_CONFIG_PATH=.env.test prisma migrate reset --force --skip-seed"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.1.0",
    "@prisma/client": "^7.1.0",
    "@tanstack/react-query": "^5.90.10",
    "@testing-library/user-event": "^14.6.1",
    "@types/cors": "^2.8.19",
    "axios": "^1.13.0",
    "bcryptjs": "^3.0.2",
    "cloudinary": "^2.8.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "react-icons": "^5.5.0",
    "redis": "^5.10.0",
    "resend": "^6.5.2",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/cookie-parser": "^1.4.3",
    "@types/express": "^5.0.5",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.19.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/supertest": "^6.0.3",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/wait-on": "^5.3.4",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.0.7",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "prisma": "^7.1.0",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.5",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "wait-on": "^9.0.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
