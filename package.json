{
  "name": "advanced-blog",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run redis:start && tsx -r tsconfig-paths/register WebApi/server.ts",
    "seed": "prisma db seed",
    "prebuild": "prisma generate",
    "build": "tsc -p tsconfig.build.json",
    "start": "node -r tsconfig-paths/register dist/WebApi/server.js",
    "test:watch": "npm run redis:start && cross-env DOTENV_CONFIG_PATH=.env.test jest --watchAll",
    "test:ci": "npm run test:db:start && npm run wait:db && npm run db:test:migrate && cross-env TEST_IN_DOCKER=true DOTENV_CONFIG_PATH=.env.test jest --runInBand && npm run test:db:stop",
    "db:test:reset": "cross-env DOTENV_CONFIG_PATH=.env.test npx prisma migrate reset --force --skip-seed --schema=prisma/schema.prisma",
    "test:db:start": "docker compose -f docker-compose.test.yml up -d",
    "test:db:stop": "docker compose -f docker-compose.test.yml down -v",
    "test": "cross-env TEST_IN_DOCKER=true npm run test:db:start && npm run ci:wait:db && npm run ci:migrate && npm run ci:test && npm run test:db:stop",
    "db:test:migrate": "cross-env DOTENV_CONFIG_PATH=.env.test prisma migrate deploy --schema=prisma/schema.prisma",
    "wait:db": "cross-env TEST_IN_DOCKER=true tsx scripts/wait-for-db.ts",
    "test:docker": "cross-env TEST_IN_DOCKER=true docker compose -f docker-compose.test.yml up --abort-on-container-exit --build",
    "redis:start": "tsx scripts/redis-start.ts",
    "ci:test": "cross-env DOTENV_CONFIG_PATH=.env.test jest --runInBand",
    "ci:migrate": "cross-env DOTENV_CONFIG_PATH=.env.test prisma migrate deploy --schema=prisma/schema.prisma",
    "ci:wait:db": "cross-env DOTENV_CONFIG_PATH=.env.test TEST_IN_DOCKER=true tsx scripts/wait-for-db.ts",
    "lint": "eslint ."
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.1.0",
    "@prisma/client": "^7.1.0",
    "@tanstack/react-query": "^5.90.10",
    "@testing-library/user-event": "^14.6.1",
    "@types/cors": "^2.8.19",
    "axios": "^1.13.0",
    "bcryptjs": "^3.0.2",
    "cloudinary": "^2.8.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-icons": "^5.5.0",
    "redis": "^5.10.0",
    "resend": "^6.5.2",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/cookie-parser": "^1.4.3",
    "@types/express": "^5.0.5",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.19.25",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/supertest": "^6.0.3",
    "@types/wait-on": "^5.3.4",
    "concurrently": "^8.2.2",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.0.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "prisma": "^7.1.0",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.5",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.20.6",
    "typescript": "^5",
    "wait-on": "^9.0.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
