    {
      "name": "Auth - Register (success)",
      "request": {
        "method": "POST",
        "header": [ { "key": "Content-Type", "value": "application/json" } ],
        "body": { "mode": "raw", "raw": "{\n  \"userName\": \"testuser\",\n  \"email\": \"test@example.com\",\n  \"password\": \"password123\"\n}" },
        "url": { "raw": "http://localhost:3000/api/register", "protocol": "http", "host": ["localhost"], "port": "3000", "path": ["api", "register"] }
      },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test(\"Status code is 201\", function () { pm.response.to.have.status(201); });",
        "pm.test(\"Inscription réussie\", function () { pm.expect(pm.response.json().message).to.eql('Inscription réussie'); });"
      ], "type": "text/javascript" } }]
    },
